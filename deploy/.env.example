# Generate the password hash with: docker run --rm caddy:2 caddy hash-password
# Keep the single quotes around the hash in .env so its $ characters are not interpolated by Docker Compose.
# If login fails, double every $ in the hash as $$.
DOMAIN=faneosis.duckdns.org
AUTH_USER=team
AUTH_HASH='PASTE_HASH_HERE'

# Persistent image library storage. Keep local until the R2 credentials below are configured.
STORAGE_BACKEND=local
LIBRARY_DIR=/data/library

# Cloudflare R2 (used when STORAGE_BACKEND=r2). Use the account endpoint only;
# pass the bucket name separately. These credentials must stay private.
R2_ENDPOINT_URL=https://ac88413dc5847b0e11784fbc87b2c205.r2.cloudflarestorage.com
R2_BUCKET_NAME=neosis-image-library
R2_ACCESS_KEY_ID=PASTE_R2_ACCESS_KEY_ID_HERE
R2_SECRET_ACCESS_KEY=PASTE_R2_SECRET_ACCESS_KEY_HERE
R2_REGION=auto
