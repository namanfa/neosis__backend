DOMAIN=faneosis.duckdns.org

# Google OAuth / OpenID Connect. Register the redirect URI exactly as written.
APP_BASE_URL=https://faneosis.duckdns.org
OAUTH_REDIRECT_URI=https://faneosis.duckdns.org/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra OIDC. Use the single organization's tenant GUID, never common/organizations.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://faneosis.duckdns.org/auth/callback
SESSION_SECRET=
SESSION_IDLE_MINUTES=480
SESSION_MAX_DAYS=7
ALLOWED_EMAIL_DOMAINS=flick2know.com,flick2know.in,fieldassist.com,fieldassist.in
ALLOWED_EMAILS=
# Comma-separated seed IR members; only inserted when the persisted IR list is empty.
IR_MEMBER_EMAILS=naman.swarnkar@fieldassist.com,naman.swarnkar@flick2know.com
TENANT_ENCRYPTION_KEY=
COOKIE_SECURE=true
AUTH_DB_PATH=/data/auth.sqlite3

# Accuracy Report temporary-upload limits (defaults: 200 images, 15 MiB each,
# 512 MiB total; processed edge 1600 px at JPEG quality 82).
ACCURACY_REPORT_MAX_IMAGES=200
ACCURACY_REPORT_MAX_IMAGE_BYTES=15728640
ACCURACY_REPORT_MAX_UPLOAD_BYTES=536870912
ACCURACY_REPORT_MAX_IMAGE_DIMENSION=1600
ACCURACY_REPORT_JPEG_QUALITY=82

# Persistent image library storage. Keep local until the R2 credentials below are configured.
STORAGE_BACKEND=local
LIBRARY_DIR=/data/library

# Cloudflare R2 (used when STORAGE_BACKEND=r2). Use the account endpoint only;
# pass the bucket name separately. These credentials must stay private.
R2_ENDPOINT_URL=https://ac88413dc5847b0e11784fbc87b2c205.r2.cloudflarestorage.com
R2_BUCKET_NAME=neosis-image-library
R2_ACCESS_KEY_ID=PASTE_R2_ACCESS_KEY_ID_HERE
R2_SECRET_ACCESS_KEY=PASTE_R2_SECRET_ACCESS_KEY_HERE
R2_REGION=auto
